# ---------------------------------------------------------------------------
# City Gadgets environment variables
# Copy this file to `.env.local` and fill in the values.
# The storefront runs fully WITHOUT these (it serves the bundled seed catalog),
# but auth, orders, and the vendor CMS require a Supabase project.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical links, sitemap, OG tags, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct DB connection for database scripts and the WebP migration.
# Use the IPv4 SESSION POOLER string — the direct db.<ref>.supabase.co host is
# IPv6-only. Dashboard → Connect → Session pooler. User is postgres.<project-ref>.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_URL=

# Service role key used only by local maintenance scripts (seeding and WebP migration writes).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
